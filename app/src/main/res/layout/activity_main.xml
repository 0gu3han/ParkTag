<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <!-- Saved Location Card -->
    <LinearLayout
        android:id="@+id/cardSavedLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/card_background"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvNoParkingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_no_parking"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSavedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Save Parking Button -->
    <Button
        android:id="@+id/btnSaveParking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_save_parking"
        android:layout_marginBottom="12dp" />

    <!-- View on Map Button -->
    <Button
        android:id="@+id/btnViewMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_view_map"
        android:layout_marginBottom="12dp"
        android:enabled="false" />

    <!-- Clear Button -->
    <Button
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_clear"
        android:layout_marginBottom="12dp"
        android:enabled="false" />

    <!-- History Button -->
    <Button
        android:id="@+id/btnHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_history" />

</LinearLayout>